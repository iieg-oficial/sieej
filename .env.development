# --- General ---
NETWORK_NAME=sieej-network

# --- Frontend ---
VITE_PORT=5174
FRONTEND_PORT=5174
VITE_BACKEND_API_HOST=/api/administrador
VITE_BASE_PATH=/
VITE_SITE_URL=http://localhost:5174
VITE_NODE_ENV=development
VITE_APP_ENV=dev
VITE_DISABLED_EDITION=false
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_RECAPTCHA_SITE_KEY=

# Proxy a mariachi-api en el host
BACKEND_DEV_TARGET=http://host.docker.internal:8000
