# ============================================
# SIEEJ frontend - Staging (build args)
# ============================================
# Usado por `make build` para generar dist/ que mariachi-nginx servira en /sieej/.

NETWORK_NAME=sieej-network

VITE_PORT=5174
FRONTEND_PORT=5174
VITE_BACKEND_API_HOST=/api/administrador
VITE_BASE_PATH=/sieej/
VITE_SITE_URL=
VITE_NODE_ENV=production
VITE_APP_ENV=beta
VITE_DISABLED_EDITION=false
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_RECAPTCHA_SITE_KEY=
