# Copia este archivo segun tu entorno:
#   cp .env.example .env.development
#   cp .env.example .env.staging
#   cp .env.example .env.production
#
# Notas:
# - SIEEJ ya no tiene backend propio. La API la sirve mariachi/api en
#   /api/administrador/formularios/*.
# - El dist generado se sirve via mariachi-nginx bajo /sieej/.
# - Solo se necesitan variables del frontend.

# --- General ---
NETWORK_NAME=sieej-network

# --- Frontend ---
VITE_PORT=<port>
FRONTEND_PORT=<port>
VITE_BACKEND_API_HOST=<path>
VITE_BASE_PATH=<path>
VITE_SITE_URL=<http://localhost:<port>|https://dominio>
VITE_NODE_ENV=<development|production>
VITE_APP_ENV=<dev|beta>
VITE_DISABLED_EDITION=<true|false>
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_RECAPTCHA_SITE_KEY=

# Proxy de desarrollo: apunta al mariachi-api (puerto del host)
BACKEND_DEV_TARGET=http://host.docker.internal:8000
