# Copia este archivo segun tu entorno:
#   cp .env.example .env.development
#   cp .env.example .env.staging
#   cp .env.example .env.production
#
# Notas:
# - SIEEJ ya no tiene backend propio. La API la sirve mariachi/api.
# - VITE_BACKEND_API_HOST debe ser exactamente '/api/administrador'
#   (sin sufijo /formularios). Los services internos arman las rutas:
#     - authServices: ${API_HOST}/autenticacion/*
#     - formulariosServices: ${API_HOST}/formularios/*
# - El dist generado se sirve via gateway-hub bajo /sieej/.
# - Solo se necesitan variables del frontend.

# --- General ---
NETWORK_NAME=sieej-network

# --- Frontend ---
VITE_PORT=<port>
FRONTEND_PORT=<port>
VITE_BACKEND_API_HOST=<path>
VITE_BASE_PATH=<path>
VITE_SITE_URL=<http://localhost:<port>|https://dominio>
VITE_NODE_ENV=<development|production>
VITE_APP_ENV=<dev|beta>
VITE_DISABLED_EDITION=<true|false>

# Analytics: GA4 se inyecta via GTM en gateway-hub (gtm.inc.template).
# SIEEJ no requiere VITE_GOOGLE_ANALYTICS_ID; ver docs/analytics.md.

# Sentry (opcional). Si VITE_SENTRY_DSN esta vacio, Sentry no se inicializa.
VITE_SENTRY_DSN=

# Proxy de desarrollo: apunta al mariachi-api (puerto del host)
BACKEND_DEV_TARGET=http://host.docker.internal:8000
